# ============================================
# Orchestrix Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# --- Server ---
PORT=8080

# --- Database ---
DB_URL="host=localhost user=postgres password=postgres dbname=orchestrix port=5432 sslmode=disable"

# --- Authentication ---
# Secret key used to sign JWT tokens. Use a long, random string in production.
JWT_SECRET=change-me-to-a-secure-random-string

# --- AI Service ---
# URL of the Python AI/RAG service. In Docker, use the service name (e.g., http://ai-service:8000).
AI_SERVICE_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed origins. Use * for development, restrict in production.
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*
