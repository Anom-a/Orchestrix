# ============================================
# Orchestrix AI Service — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# --- API Keys ---
# Your Google Gemini API key (required for LLM calls)
GOOGLE_API_KEY=your-google-api-key-here

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Model ---
# Gemini model to use for RAG responses
GEMINI_MODEL=gemini-2.5-flash

# --- Storage ---
# Path to the backend storage root (where uploaded documents live)
# In Docker with shared volumes, this might be /app/shared-storage
STORAGE_PATH=../backend

# --- CORS ---
# Comma-separated allowed origins. Use * for development.
CORS_ORIGINS=*
