# ============================================
# Orchestrix — Root Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# These are used by docker-compose.yml

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrix

# --- Backend ---
BACKEND_PORT=8080
JWT_SECRET=change-me-to-a-secure-random-string

# --- AI Service ---
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend ---
# The backend URL as seen from the browser (not from inside Docker)
VITE_API_URL=http://localhost:8080

# --- CORS ---
# Comma-separated list of allowed origins for both backend and ai-service
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
